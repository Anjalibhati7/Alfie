# Alfie agent runtime configuration.
#
# This file IS loaded by the service. Copy it to `services/agent/.env` for local
# development, or inject the same names as InstaCloud secrets. An existing
# process environment variable always wins over the file, so shells, Docker, and
# InstaCloud secrets behave exactly as before.
#
# NEVER commit real values. `.env` is gitignored; this example is value-free.

# --- Required for live voice -------------------------------------------------
# Server-side only. It must never appear in mobile code, the app bundle, Git, or
# logs. The mobile app connects to this service, not to Boson directly.
#
# Quote characters are stripped, so both of these work:
#   BOSON_API_KEY=bai-xxxx
#   BOSON_API_KEY="bai-xxxx"
# A missing or rejected key makes every session fail with WebSocket close code
# 3000. Verify with: npm run probe --workspace @alfie/agent
BOSON_API_KEY=

# --- Optional ----------------------------------------------------------------
PORT=8080
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime
BOSON_REALTIME_MODEL=higgs-realtime
# Comma-separated browser origins allowed to open a voice socket.
# Empty means "allow any origin", which is fine for a local demo only.
# Native iOS/Android clients send no Origin header and are always allowed.
ALLOWED_ORIGINS=
# Hard cap on one voice session, in milliseconds (default 30 minutes).
MAX_SESSION_MS=1800000
# Set to `off` to silence the structured voice diagnostics.
LOG_LEVEL=info
